--// Server Hop Tracker — Axiom UI
--// Watches for a target player; when they join, hop to a new server.
--// Persists target name + toggle state across hops.

-- ══════════════════════════════════════════════════════════════════
--  CONFIG — fill this in if you host the script somewhere
-- ══════════════════════════════════════════════════════════════════
local LOADER_URL = "https://raw.githubusercontent.com/panchito-beep1/123123d/refs/heads/main/SOur"

local MAX_ATTEMPTS = 10
local SLOT_HEADROOM = 2
local RETRY_DELAY = 1.5

-- Tick interval for the presence loop. Roblox clamps task.wait() to
-- ~1 frame (≈0.0167s at 60 FPS), so 0.01 is effectively per-frame.
local TICK_INTERVAL = 0.01

-- ══════════════════════════════════════════════════════════════════

local Axiom = loadstring(game:HttpGet(
    "https://raw.githubusercontent.com/panchito-beep1/AXIOM/refs/heads/main/AxiomV5"
))()

local Players         = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local HttpService     = game:GetService("HttpService")

local LocalPlayer = Players.LocalPlayer
local PlaceId     = game.PlaceId
local JobId       = game.JobId

--=====================================================================
-- Environment + availability
--=====================================================================
local ENV = (function()
    if type(getgenv) == "function" then
        local ok, env = pcall(getgenv)
        if ok and type(env) == "table" then return env end
    end
    return _G
end)()

local function hasFn(name)
    local fn = ENV[name]
    if type(fn) ~= "function" then fn = _G[name] end
    return type(fn) == "function"
end

local caps = {}
caps.queueOnTeleport = hasFn("queue_on_teleport")

--=====================================================================
-- Persistence roundtrip
--=====================================================================
local function testPersistence()
    if not (hasFn("writefile") and hasFn("readfile")) then
        return false, "writefile/readfile missing"
    end
    local testPath = "serverhop_tracker_selftest.tmp"
    local token = "selftest_" .. tostring(os.time()) .. "_" .. tostring(math.random(1, 1e7))
    local okW, errW = pcall(writefile, testPath, token)
    if not okW then return false, "writefile failed: " .. tostring(errW) end
    local okR, content = pcall(readfile, testPath)
    if hasFn("delfile") then pcall(delfile, testPath) end
    if not okR then return false, "readfile failed: " .. tostring(content) end
    if content ~= token then return false, "roundtrip mismatch" end
    return true, "ok"
end

local persistenceOK, persistenceReason = testPersistence()
caps.persistence = persistenceOK

--=====================================================================
-- Source-function availability
--=====================================================================
local SOURCE_FNS = {
    "getscriptsource",
    "getscriptbytecode",
    "decompile",
    "getscriptclosure",
    "getloadedmodules",
    "getgc",
}

local fnAvailable = {}
for _, name in ipairs(SOURCE_FNS) do
    fnAvailable[name] = hasFn(name)
end

for _, name in ipairs(SOURCE_FNS) do
    print("[ServerHopTracker] " .. name .. ":", fnAvailable[name] and "function" or "nil")
end

--=====================================================================
-- Source retrieval (Method A)
--=====================================================================
local function collectCandidates()
    local candidates = {}

    if fnAvailable.getscriptclosure then
        local ok, closure = pcall(getscriptclosure)
        if ok and closure ~= nil then
            table.insert(candidates, { obj = closure, name = "getscriptclosure()" })
        end
    end

    local okScript, scriptVal = pcall(function() return script end)
    if okScript and scriptVal ~= nil then
        table.insert(candidates, { obj = scriptVal, name = "script" })
    end

    local infoFn = (debug and (debug.info or debug.getinfo))
    if infoFn then
        for level = 1, 6 do
            local ok, info = pcall(infoFn, level, "f")
            if ok and type(info) == "function" then
                table.insert(candidates, {
                    obj = info,
                    name = "debug.info(" .. level .. ")"
                })
            end
        end
    end

    return candidates
end

local function tryGetSource()
    local candidates = collectCandidates()

    if fnAvailable.getscriptsource then
        for _, c in ipairs(candidates) do
            local ok, src = pcall(getscriptsource, c.obj)
            if ok and type(src) == "string" and src ~= "" then
                return src, "getscriptsource(" .. c.name .. ")"
            end
        end
        local ok, src = pcall(getscriptsource)
        if ok and type(src) == "string" and src ~= "" then
            return src, "getscriptsource()"
        end
    end

    if fnAvailable.decompile then
        for _, c in ipairs(candidates) do
            local ok, src = pcall(decompile, c.obj)
            if ok and type(src) == "string" and src ~= "" then
                return src, "decompile(" .. c.name .. ")"
            end
        end
    end

    if fnAvailable.getscriptbytecode and fnAvailable.decompile then
        local ok, bc = pcall(getscriptbytecode)
        if ok and type(bc) == "string" and bc ~= "" then
            local ok2, src = pcall(decompile, bc)
            if ok2 and type(src) == "string" and src ~= "" then
                return src, "decompile(getscriptbytecode())"
            end
        end
    end

    return nil, nil
end

local SCRIPT_SOURCE, SOURCE_METHOD = tryGetSource()

--=====================================================================
-- Source cache (Method B1)
--=====================================================================
local SOURCE_CACHE_FILE = "serverhop_tracker_source.lua"

local function hasCache()
    if not caps.persistence then return false end
    if not isfile(SOURCE_CACHE_FILE) then return false end
    local ok, content = pcall(readfile, SOURCE_CACHE_FILE)
    return ok and type(content) == "string" and content ~= ""
end

local cacheWrittenThisRun = false
if SCRIPT_SOURCE and caps.persistence then
    local ok = pcall(writefile, SOURCE_CACHE_FILE, SCRIPT_SOURCE)
    if ok then
        local ok2, content = pcall(readfile, SOURCE_CACHE_FILE)
        if ok2 and content == SCRIPT_SOURCE then
            cacheWrittenThisRun = true
            print("[ServerHopTracker] Source cached to " .. SOURCE_CACHE_FILE)
        else
            warn("[ServerHopTracker] Cache write succeeded but readback mismatched.")
        end
    else
        warn("[ServerHopTracker] Failed to cache source.")
    end
end

local function hasLoaderUrl()
    return LOADER_URL ~= "" and type(game.HttpGet) == "function"
end

caps.httpGet = type(game.HttpGet) == "function"

--=====================================================================
-- Reload mode
--=====================================================================
local reloadMode
if SCRIPT_SOURCE and caps.queueOnTeleport then
    reloadMode = "direct"
elseif hasCache() and caps.queueOnTeleport then
    reloadMode = "cache"
elseif hasLoaderUrl() and caps.queueOnTeleport then
    reloadMode = "url"
else
    reloadMode = nil
end

--=====================================================================
-- Persistence
--=====================================================================
local CONFIG_FILE = "serverhop_tracker_config.json"

local function loadConfig()
    local cfg = { targetName = "", enabled = false }
    if not caps.persistence then return cfg end
    if isfile(CONFIG_FILE) then
        local ok, raw = pcall(readfile, CONFIG_FILE)
        if ok and raw and raw ~= "" then
            local ok2, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
            if ok2 and type(decoded) == "table" then
                cfg.targetName = decoded.targetName or ""
                cfg.enabled    = decoded.enabled or false
            end
        end
    end
    return cfg
end

local function saveConfig(cfg)
    if not caps.persistence then return end
    pcall(writefile, CONFIG_FILE, HttpService:JSONEncode(cfg))
end

local cfg = loadConfig()

local state = {
    targetName = cfg.targetName,
    enabled    = cfg.enabled,
    status     = "Idle",
    hopping    = false,

    -- Presence tracking (loop-driven)
    targetPresent         = false,
    triggeredForPresence  = false,

    -- Hop session tracking
    serverQueue   = {},
    blacklist     = {},
    attemptCount  = 0,
    currentServer = nil,
}

local updateStatus   -- forward declaration
local tryNextServer  -- forward declaration

local function persist()
    saveConfig({ targetName = state.targetName, enabled = state.enabled })
end

--=====================================================================
-- Server candidate fetch
--=====================================================================
local function fetchCandidates()
    if not caps.httpGet then return {} end

    local url = string.format(
        "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100",
        PlaceId
    )
    local ok, res = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(url))
    end)
    if not ok or type(res) ~= "table" or not res.data then return {} end

    local list = {}
    for _, s in ipairs(res.data) do
        local free = (s.maxPlayers or 0) - (s.playing or 0)
        if s.id ~= JobId
            and not state.blacklist[s.id]
            and s.playing ~= nil and s.maxPlayers ~= nil
            and free >= SLOT_HEADROOM then
            table.insert(list, {
                id = s.id,
                playing = s.playing,
                maxPlayers = s.maxPlayers,
                free = free,
            })
        end
    end

    table.sort(list, function(a, b)
        if a.free ~= b.free then return a.free > b.free end
        return (a.playing / a.maxPlayers) < (b.playing / b.maxPlayers)
    end)

    return list
end

local function nextCandidate()
    while #state.serverQueue > 0 do
        local s = table.remove(state.serverQueue, 1)
        if not state.blacklist[s.id] then
            return s
        end
    end
    return nil
end

--=====================================================================
-- Async teleport failure handler
--=====================================================================
TeleportService.TeleportInitFailed:Connect(function(plr, result, errMsg)
    if plr ~= LocalPlayer then return end

    local resultName = (typeof(result) == "EnumItem" and result.Name) or tostring(result)
    warn(string.format(
        "[ServerHopTracker] TeleportInitFailed: %s — %s",
        resultName, tostring(errMsg)
    ))

    if state.currentServer then
        state.blacklist[state.currentServer.id] = true
        state.currentServer = nil
    end

    if state.hopping then
        state.status = string.format("Retry after %s...", resultName)
        updateStatus()
        task.delay(RETRY_DELAY, tryNextServer)
    else
        state.status = "TP failed: " .. resultName
        updateStatus()
    end
end)

--=====================================================================
-- Hop logic
--=====================================================================
local function buildReloadPayload()
    if reloadMode == "direct" and SCRIPT_SOURCE then
        return SCRIPT_SOURCE
    end
    if reloadMode == "cache" then
        return string.format("loadstring(readfile(%q))()", SOURCE_CACHE_FILE)
    end
    if reloadMode == "url" then
        return string.format("loadstring(game:HttpGet(%q))()", LOADER_URL)
    end
    return nil
end

tryNextServer = function()
    if not state.hopping then return end

    state.attemptCount = state.attemptCount + 1

    if state.attemptCount > MAX_ATTEMPTS then
        state.hopping = false
        state.status = string.format("Gave up after %d attempts", MAX_ATTEMPTS)
        updateStatus()
        return
    end

    local server = nextCandidate()
    if not server then
        state.serverQueue = fetchCandidates()
        server = nextCandidate()
    end

    if not server then
        state.hopping = false
        state.status = "No servers with free slots"
        updateStatus()
        return
    end

    state.currentServer = server
    state.status = string.format(
        "Attempt %d/%d — %d/%d slots (%d free)",
        state.attemptCount, MAX_ATTEMPTS,
        server.playing, server.maxPlayers, server.free
    )
    updateStatus()

    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, server.id, LocalPlayer)
    end)
    if not ok then
        warn("[ServerHopTracker] Teleport call threw: " .. tostring(err))
        state.blacklist[server.id] = true
        state.currentServer = nil
        if state.hopping then
            task.delay(RETRY_DELAY, tryNextServer)
        end
    end
end

local function serverHop(force, fresh)
    if state.hopping and not force then return end

    if fresh then
        state.blacklist = {}
        state.serverQueue = {}
        state.attemptCount = 0
        state.currentServer = nil
    end

    state.hopping = true
    state.status = "Hopping..."
    updateStatus()
    persist()

    if reloadMode then
        local payload = buildReloadPayload()
        if payload then
            local ok, err = pcall(queue_on_teleport, payload)
            if not ok then
                warn("[ServerHopTracker] queue_on_teleport failed: " .. tostring(err))
            end
        end
    end

    tryNextServer()
end

local function retryTeleport()
    state.hopping = false
    state.triggeredForPresence = false  -- allow detection loop to re-trigger
    serverHop(true, true)
end

--=====================================================================
-- Presence loop (constant check)
--=====================================================================
-- Runs every tick. Handles three transitions:
--   target absent → present : refresh status, fire hop if armed
--   target present → absent : reset trigger latch so next join re-fires
--   (no change)              : no-op
--
-- `triggeredForPresence` debounces: while the target is continuously
-- in the server, we only fire serverHop() once. If the hop fails and
-- we're still here, the latch stays engaged until the target leaves
-- or the user hits Retry.
local function tick()
    if state.targetName == "" then return end

    local present = false
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Name:lower() == state.targetName:lower() then
            present = true
            break
        end
    end

    if present ~= state.targetPresent then
        state.targetPresent = present

        if present then
            state.status = "Target detected"
            print("[ServerHopTracker] Target present: " .. state.targetName)
        else
            state.triggeredForPresence = false
            state.status = "Target left"
            print("[ServerHopTracker] Target left: " .. state.targetName)
        end

        updateStatus()
    end

    if state.enabled
        and present
        and not state.triggeredForPresence
        and not state.hopping then
        state.triggeredForPresence = true
        serverHop(false, true)
    end
end

task.spawn(function()
    while true do
        local ok, err = pcall(tick)
        if not ok then
            warn("[ServerHopTracker] tick error: " .. tostring(err))
        end
        task.wait(TICK_INTERVAL)
    end
end)

--=====================================================================
-- Axiom GUI
--=====================================================================
local win = Axiom.new("Server Hop Tracker")
local tab = win:AddTab("Tracker")

tab:AddLabel("Hops servers automatically when the target player joins.")

tab:AddTextBox(
    "Target Player",
    "Username...",
    state.targetName,
    function(text)
        state.targetName = text
        -- Reset presence latch when target name changes.
        state.targetPresent = false
        state.triggeredForPresence = false
        persist()
        updateStatus()
    end
)

tab:AddCheckbox("Enable Auto Server Hop", state.enabled, function(on)
    state.enabled = on
    if not on then
        -- Disarming: clear the latch so re-enabling re-checks.
        state.triggeredForPresence = false
    end
    persist()
    updateStatus()
end)

tab:AddSeparator()

tab:AddButton("Hop Now", function()
    serverHop(false, true)
end, { Color = Color3.fromRGB(0, 170, 90) })

tab:AddButton("Retry Teleport", function()
    retryTeleport()
end, { Color = Color3.fromRGB(220, 50, 50) })

--=====================================================================
-- Live status table
--=====================================================================
local STATUS_HEADERS = {"Setting", "Value"}

local function reloadModeLabel()
    if reloadMode == "direct" then return "A: direct source" end
    if reloadMode == "cache"  then return "B1: cached source file" end
    if reloadMode == "url"    then return "B2: loader URL" end
    return "none"
end

local function cacheStatusLabel()
    if cacheWrittenThisRun then return "yes (written this run)" end
    if hasCache() then return "yes (pre-existing)" end
    return "no"
end

local function blacklistCount()
    local n = 0
    for _ in pairs(state.blacklist) do n = n + 1 end
    return n
end

local function buildRows()
    return {
        {"Target",        state.targetName ~= "" and state.targetName or "<none>"},
        {"Target present",state.targetPresent and "YES" or "no"},
        {"Trigger latch", state.triggeredForPresence and "engaged" or "ready"},
        {"Enabled",       state.enabled and "ON" or "OFF"},
        {"Status",        state.status},
        {"Hopping lock",  state.hopping and "ENGAGED" or "released"},
        {"Attempt",       string.format("%d / %d", state.attemptCount, MAX_ATTEMPTS)},
        {"Queue",         string.format("%d servers", #state.serverQueue)},
        {"Blacklisted",   tostring(blacklistCount())},
        {"Auto-reload",   reloadMode and "supported" or "NOT supported"},
        {"Reload method", reloadModeLabel()},
        {"Source method", SOURCE_METHOD or "<none>"},
        {"Source cached", cacheStatusLabel()},
        {"Persistence",   caps.persistence and "supported" or "NOT supported"},
        {"HttpGet",       caps.httpGet and "supported" or "NOT supported"},
    }
end

local statusTable = tab:AddTable(STATUS_HEADERS, buildRows(), {MaxHeight = 320})

updateStatus = function()
    statusTable:Destroy()
    statusTable = tab:AddTable(STATUS_HEADERS, buildRows(), {MaxHeight = 320})
end

--=====================================================================
-- Source-function availability table
--=====================================================================
tab:AddSeparator()
tab:AddLabel("Executor source-function availability:")

local DIAG_HEADERS = {"Function", "Available"}
local diagRows = {}
for _, name in ipairs(SOURCE_FNS) do
    table.insert(diagRows, {name, fnAvailable[name] and "yes" or "no"})
end
tab:AddTable(DIAG_HEADERS, diagRows, {MaxHeight = 160})

--=====================================================================
-- Capability warnings
--=====================================================================
local missing = {}
if not caps.persistence then
    table.insert(missing,
        "• Persistence unavailable (" .. (persistenceReason or "unknown") .. ")\n"
        .. "   →  settings will NOT save between sessions, and the source cache is unavailable")
end
if not caps.queueOnTeleport then
    table.insert(missing,
        "• queue_on_teleport is missing\n"
        .. "   →  script will NOT auto-restart after a hop")
elseif not reloadMode then
    local why
    if not SCRIPT_SOURCE and not hasCache() and not hasLoaderUrl() then
        why = "Method A failed, no source cache, and LOADER_URL is empty"
    elseif not SCRIPT_SOURCE and not hasCache() then
        why = "Method A failed and no source cache exists"
    else
        why = "unknown"
    end
    table.insert(missing, "• Auto-reload unavailable\n   →  " .. why)
end
if not caps.httpGet then
    table.insert(missing,
        "• game.HttpGet is missing\n"
        .. "   →  server lookup unavailable; script will fall back to a random hop")
end

if #missing > 0 then
    win:ShowDialog({
        Title = "Capability Report",
        Message = "The following capabilities are unavailable on this executor:\n\n"
            .. table.concat(missing, "\n\n")
            .. "\n\nThe script will still run, but with the limitations listed above.",
        Buttons = {
            { Text = "OK", Callback = function() end },
        },
    })
end
